# ============================================================
# CS AGENT SENTINEL - CONFIGURAÇÃO DE AMBIENTE
# ============================================================

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a ser utilizado (Recomendado: gemini-3.8-flash ou gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# String de Conexão com o MongoDB (Read-Only de telemetria)
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/?appName=Cluster0

# Nome do Banco de Dados no MongoDB
MONGODB_DB_NAME=hackathon_db

# Webhook corporativo para disparo de alertas (Opcional - Slack, Discord, Microsoft Teams, n8n, etc.)
CS_WEBHOOK_URL=

# ============================================================
# AUTOMAÇÃO & CRON JOBS
# ============================================================
# Segredo para autenticar requisições na rota /api/cron/audit (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=kenit_secret_cron_token_12345

# URL base da aplicação para links em e-mails e webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# NOTIFICAÇÕES POR E-MAIL PRESCRITIVO PARA O TIME DE CS
# ============================================================
# Provedor 1: Resend (Recomendado - obtenha em https://resend.com)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=CS Sentinel <onboarding@resend.dev>

# Provedor 2: SMTP Alternativo (Nodemailer - Gmail, Sendgrid, Mailgun, etc.)
# Se RESEND_API_KEY não estiver configurada, o sistema utilizará as variáveis SMTP abaixo:
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@seudominio.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM="Kenit CS Sentinel" <cs@kenit.com.br>
